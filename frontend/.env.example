# Supabase — Project Settings > API
# MUST be the anon / publishable key. Never the service_role key:
# anything prefixed NEXT_PUBLIC_ is shipped to every visitor's browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# FastAPI engine. Leave blank for local dev (falls back to the current host on :8000).
NEXT_PUBLIC_API_URL=

# Alamat dasar untuk link email (verifikasi, reset sandi). Kosongkan untuk
# memakai origin browser; isi di production supaya link tidak menunjuk localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
